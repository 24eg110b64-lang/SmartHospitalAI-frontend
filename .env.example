# =============================================================
# SmartHospitalAI — Frontend (Vite / React) env variables
# =============================================================
# For local development: copy this file to .env and fill in values.
# For Vercel production: add these as Environment Variables in
#   the Vercel dashboard — never commit a .env file.
# =============================================================

# Spring Boot backend URL
# Local:      http://localhost:8081
# Production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:8081

# Flask AI prediction service URL
# Local:      http://localhost:5000
# Production: https://your-ai-service.onrender.com
VITE_AI_API_URL=http://localhost:5000
